# ============================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================
# Copy this file to .env and update with your values
# DO NOT commit .env file to git (add it to .gitignore)

# API Configuration
# Development: http://localhost:4000/api/v1
# Production: https://api.yourdomain.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Environment
# Options: development, production, staging
VITE_ENV=development

# Cloudinary Configuration (Image Uploads)
# These are PUBLIC credentials - safe to expose
# Get from https://cloudinary.com/console/settings/api-keys
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key

# Important Security Notes:
# ========================
# 1. NEVER add backend secrets (JWT_SECRET, DB_URL, API passwords) to frontend
# 2. NEVER add CLOUDINARY_API_SECRET to frontend (backend only)
# 3. NEVER add API keys or tokens (except public ones) to frontend
# 4. Use import.meta.env.VITE_* to access variables in code
#
# Environment variables that start with VITE_ are automatically exposed
# Variables without VITE_ prefix are only available on server side
